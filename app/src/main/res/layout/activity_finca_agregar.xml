<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white"
    android:gravity="center">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo_uteq"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crear Nueva Finca"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nombreFincaLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:boxStrokeColor="#007224"
        app:hintTextColor="#007224">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txtNombreNuevaFinca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del Espacio / Finca"
            android:inputType="textPersonName"
            android:textSize="18sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnCrearFinca"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Crear y Continuar"
        android:backgroundTint="#007224"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

</LinearLayout>
